{
  "countryCode": "IDN",
  "countryName": "Indonesia",
  "schemaVersion": "1.0.0",
  "lastUpdated": "2026-03-25T00:00:00Z",
  "portalUrl": "https://ecd.beacukai.go.id",
  "portalLaunchMode": "webview",
  "portalName": "Indonesia Electronic Customs Declaration (e-CD)",
  "submissionDeadlineHours": 0,
  "recommendedLeadTimeHours": 24,
  "submissionWindowNote": "Submit before or upon arrival",
  "passportValidityMonths": 6,
  "metadata": {
    "priority": 7,
    "complexity": "medium",
    "popularity": 80,
    "lastVerified": "2026-03-25T00:00:00Z",
    "supportedLanguages": ["en", "id"],
    "implementationStatus": "complete",
    "maintenanceFrequency": "monthly"
  },
  "changeDetection": {
    "monitoredSelectors": [".ecd-form", ".customs-form", "#submit-declaration"],
    "changeThreshold": 20,
    "fallbackActions": [
      {
        "trigger": "form_layout_changed",
        "action": "notify",
        "message": "Indonesia e-CD form layout has changed. Please verify manually."
      }
    ]
  },
  "submission": {
    "earliestBeforeArrival": "7d",
    "latestBeforeArrival": "0h",
    "recommended": "24h",
    "processingTime": "instant"
  },
  "portalFlow": {
    "requiresAccount": false,
    "familyPolicy": {
      "type": "family",
      "description": "One declaration per family traveling together; individual travelers submit separately"
    },
    "multiStep": true,
    "canSaveProgress": false,
    "sessionTimeout": "20m",
    "prerequisites": [
      {
        "type": "document",
        "description": "Passport valid for at least 6 months",
        "required": true
      }
    ]
  },
  "sections": [
    {
      "id": "personal",
      "title": "Personal Information",
      "fields": [
        {
          "id": "surname",
          "label": "Family Name (as on passport)",
          "type": "text",
          "required": true,
          "autoFillSource": "profile.surname",
          "countrySpecific": false,
          "automation": {
            "selector": "#surname",
            "fillMethod": "input"
          }
        },
        {
          "id": "givenName",
          "label": "Given Name (First Name)",
          "type": "text",
          "required": true,
          "autoFillSource": "profile.givenNames",
          "countrySpecific": false,
          "automation": {
            "selector": "#givenName",
            "fillMethod": "input"
          }
        },
        {
          "id": "dateOfBirth",
          "label": "Date of Birth",
          "type": "date",
          "required": true,
          "autoFillSource": "profile.dateOfBirth",
          "countrySpecific": false,
          "automation": {
            "selector": "#dateOfBirth",
            "fillMethod": "input"
          }
        },
        {
          "id": "gender",
          "label": "Gender",
          "type": "searchable_select",
          "required": true,
          "autoFillSource": "profile.gender",
          "countrySpecific": false,
          "options": [
            { "value": "M", "label": "Male" },
            { "value": "F", "label": "Female" }
          ],
          "automation": {
            "selector": "#gender",
            "fillMethod": "select"
          }
        },
        {
          "id": "nationality",
          "label": "Nationality",
          "type": "text",
          "required": true,
          "autoFillSource": "profile.nationality",
          "countrySpecific": false,
          "automation": {
            "selector": "#nationality",
            "fillMethod": "input"
          }
        },
        {
          "id": "occupation",
          "label": "Occupation",
          "type": "searchable_select",
          "required": true,
          "autoFillSource": "profile.occupation",
          "countrySpecific": true,
          "options": [
            { "value": "employee", "label": "Employee" },
            { "value": "entrepreneur", "label": "Entrepreneur" },
            { "value": "government", "label": "Government Official" },
            { "value": "professional", "label": "Professional" },
            { "value": "student", "label": "Student" },
            { "value": "retired", "label": "Retired" },
            { "value": "housewife", "label": "Housewife / Homemaker" },
            { "value": "diplomat", "label": "Diplomat" },
            { "value": "other", "label": "Other" }
          ],
          "autoFillMapping": {
            "Software Developer": "employee",
            "Engineer": "professional",
            "Doctor": "professional",
            "Teacher": "employee",
            "Student": "student",
            "Retired": "retired",
            "_default": "other"
          },
          "automation": {
            "selector": "#occupation",
            "fillMethod": "select"
          }
        }
      ]
    },
    {
      "id": "passport",
      "title": "Passport Information",
      "fields": [
        {
          "id": "passportNumber",
          "label": "Passport Number",
          "type": "text",
          "required": true,
          "autoFillSource": "profile.passportNumber",
          "countrySpecific": false,
          "automation": {
            "selector": "#passportNumber",
            "fillMethod": "input"
          }
        },
        {
          "id": "passportIssuedDate",
          "label": "Passport Issue Date",
          "type": "date",
          "required": true,
          "autoFillSource": "profile.passportIssued",
          "countrySpecific": false,
          "automation": {
            "selector": "#passportIssuedDate",
            "fillMethod": "input"
          }
        },
        {
          "id": "passportExpiry",
          "label": "Passport Expiry Date",
          "type": "date",
          "required": true,
          "autoFillSource": "profile.passportExpiry",
          "countrySpecific": false,
          "automation": {
            "selector": "#passportExpiry",
            "fillMethod": "input"
          }
        },
        {
          "id": "passportIssuingCountry",
          "label": "Passport Issuing Country",
          "type": "text",
          "required": true,
          "autoFillSource": "profile.nationality",
          "countrySpecific": false,
          "automation": {
            "selector": "#passportIssuingCountry",
            "fillMethod": "input"
          }
        }
      ]
    },
    {
      "id": "flight",
      "title": "Flight Information",
      "fields": [
        {
          "id": "arrivalDate",
          "label": "Date of Arrival",
          "type": "date",
          "required": true,
          "autoFillSource": "leg.arrivalDate",
          "countrySpecific": false,
          "automation": {
            "selector": "#arrivalDate",
            "fillMethod": "input"
          }
        },
        {
          "id": "flightNumber",
          "label": "Flight Number",
          "type": "text",
          "required": true,
          "autoFillSource": "leg.flightNumber",
          "countrySpecific": false,
          "automation": {
            "selector": "#flightNumber",
            "fillMethod": "input"
          }
        },
        {
          "id": "portOfArrival",
          "label": "Port of Arrival",
          "type": "searchable_select",
          "required": true,
          "countrySpecific": true,
          "options": [
            { "value": "CGK", "label": "Soekarno-Hatta International Airport (Jakarta)" },
            { "value": "DPS", "label": "Ngurah Rai International Airport (Bali)" },
            { "value": "SUB", "label": "Juanda International Airport (Surabaya)" },
            { "value": "UPG", "label": "Sultan Hasanuddin International Airport (Makassar)" },
            { "value": "KNO", "label": "Kualanamu International Airport (Medan)" },
            { "value": "JOG", "label": "Yogyakarta International Airport" },
            { "value": "BPN", "label": "Sultan Aji Muhammad Sulaiman Airport (Balikpapan)" },
            { "value": "MES", "label": "Minangkabau International Airport (Padang)" },
            { "value": "other", "label": "Other" }
          ],
          "helpText": "Select the airport where you will arrive in Indonesia",
          "automation": {
            "selector": "#portOfArrival",
            "fillMethod": "select"
          }
        },
        {
          "id": "departureCountry",
          "label": "Country of Departure",
          "type": "text",
          "required": true,
          "autoFillSource": "leg.departureCountry",
          "countrySpecific": false,
          "automation": {
            "selector": "#departureCountry",
            "fillMethod": "input"
          }
        }
      ]
    },
    {
      "id": "accommodation",
      "title": "Accommodation in Indonesia",
      "fields": [
        {
          "id": "accommodationAddress",
          "label": "Address in Indonesia",
          "type": "textarea",
          "required": true,
          "autoFillSource": "leg.accommodation.address._formatted",
          "countrySpecific": false,
          "helpText": "Full address of your hotel or place of stay",
          "automation": {
            "selector": "#accommodationAddress",
            "fillMethod": "input"
          }
        },
        {
          "id": "cityOfStay",
          "label": "City of Destination",
          "type": "searchable_select",
          "required": true,
          "autoFillSource": "leg.accommodation.address.city",
          "countrySpecific": true,
          "options": [
            { "value": "jakarta", "label": "Jakarta" },
            { "value": "bali", "label": "Bali (Denpasar)" },
            { "value": "surabaya", "label": "Surabaya" },
            { "value": "yogyakarta", "label": "Yogyakarta" },
            { "value": "bandung", "label": "Bandung" },
            { "value": "makassar", "label": "Makassar" },
            { "value": "medan", "label": "Medan" },
            { "value": "semarang", "label": "Semarang" },
            { "value": "lombok", "label": "Lombok" },
            { "value": "other", "label": "Other" }
          ],
          "automation": {
            "selector": "#cityOfStay",
            "fillMethod": "select"
          }
        },
        {
          "id": "stayDuration",
          "label": "Duration of Stay (days)",
          "type": "number",
          "required": true,
          "autoFillSource": "leg._calculatedDuration",
          "countrySpecific": false,
          "validation": {
            "min": 1,
            "max": 30
          },
          "helpText": "Visa on arrival allows up to 30 days",
          "automation": {
            "selector": "#stayDuration",
            "fillMethod": "input"
          }
        }
      ]
    },
    {
      "id": "customs",
      "title": "Customs Declaration",
      "fields": [
        {
          "id": "carryingCurrency",
          "label": "Are you carrying currency or negotiable instruments exceeding IDR 100,000,000 (or equivalent)?",
          "type": "boolean",
          "required": true,
          "countrySpecific": true,
          "automation": {
            "selector": "#carryingCurrency",
            "fillMethod": "click"
          }
        },
        {
          "id": "currencyAmount",
          "label": "Total currency amount (if exceeding limit)",
          "type": "text",
          "required": false,
          "countrySpecific": true,
          "helpText": "Specify amount and currency type",
          "automation": {
            "selector": "#currencyAmount",
            "fillMethod": "input"
          }
        },
        {
          "id": "carryingGoods",
          "label": "Are you carrying goods exceeding duty-free allowance (USD 500 per person)?",
          "type": "boolean",
          "required": true,
          "countrySpecific": true,
          "automation": {
            "selector": "#carryingGoods",
            "fillMethod": "click"
          }
        },
        {
          "id": "carryingAnimalsPlants",
          "label": "Are you carrying animals, fish, plants, or products thereof?",
          "type": "boolean",
          "required": true,
          "countrySpecific": true,
          "automation": {
            "selector": "#carryingAnimalsPlants",
            "fillMethod": "click"
          }
        },
        {
          "id": "carryingNarcotics",
          "label": "Are you carrying narcotics, psychotropic substances, firearms, or explosives?",
          "type": "boolean",
          "required": true,
          "countrySpecific": true,
          "automation": {
            "selector": "#carryingNarcotics",
            "fillMethod": "click"
          }
        },
        {
          "id": "carryingCommercialGoods",
          "label": "Are you carrying goods for commercial purposes?",
          "type": "boolean",
          "required": true,
          "countrySpecific": true,
          "automation": {
            "selector": "#carryingCommercialGoods",
            "fillMethod": "click"
          }
        },
        {
          "id": "alcoholQuantity",
          "label": "Alcohol quantity (liters)",
          "type": "number",
          "required": false,
          "countrySpecific": true,
          "validation": {
            "min": 0,
            "max": 10
          },
          "helpText": "Duty-free allowance: 1 liter per adult",
          "automation": {
            "selector": "#alcoholQuantity",
            "fillMethod": "input"
          }
        },
        {
          "id": "tobaccoQuantity",
          "label": "Cigarettes quantity",
          "type": "number",
          "required": false,
          "countrySpecific": true,
          "validation": {
            "min": 0,
            "max": 1000
          },
          "helpText": "Duty-free allowance: 200 cigarettes or 25 cigars or 100g tobacco",
          "automation": {
            "selector": "#tobaccoQuantity",
            "fillMethod": "input"
          }
        }
      ]
    },
    {
      "id": "contact",
      "title": "Contact Information",
      "fields": [
        {
          "id": "homeAddress",
          "label": "Permanent Address in Home Country",
          "type": "textarea",
          "required": true,
          "autoFillSource": "profile.address._formatted",
          "countrySpecific": false,
          "automation": {
            "selector": "#homeAddress",
            "fillMethod": "input"
          }
        },
        {
          "id": "phoneNumber",
          "label": "Phone Number",
          "type": "text",
          "required": true,
          "autoFillSource": "profile.phone",
          "countrySpecific": false,
          "automation": {
            "selector": "#phoneNumber",
            "fillMethod": "input"
          }
        },
        {
          "id": "email",
          "label": "Email Address",
          "type": "text",
          "required": true,
          "autoFillSource": "profile.email",
          "countrySpecific": false,
          "validation": {
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
          },
          "automation": {
            "selector": "#email",
            "fillMethod": "input"
          }
        }
      ]
    }
  ],
  "submissionGuide": [
    {
      "order": 1,
      "title": "Access Indonesia e-CD Portal",
      "description": "Navigate to the Electronic Customs Declaration portal. No account registration is required.",
      "fieldsOnThisScreen": [],
      "tips": [
        "Use the official Bea Cukai (Customs) website",
        "Have your passport, flight ticket, and accommodation details ready",
        "Available in English and Bahasa Indonesia"
      ]
    },
    {
      "order": 2,
      "title": "Enter Personal Information",
      "description": "Fill in your personal details exactly as they appear on your passport.",
      "fieldsOnThisScreen": ["surname", "givenName", "dateOfBirth", "gender", "nationality", "occupation"],
      "tips": [
        "Names must match passport exactly",
        "Select your occupation from the provided categories",
        "One form per family if traveling together"
      ]
    },
    {
      "order": 3,
      "title": "Passport Details",
      "description": "Enter your passport information from the data page.",
      "fieldsOnThisScreen": ["passportNumber", "passportIssuedDate", "passportExpiry", "passportIssuingCountry"],
      "tips": [
        "Passport must be valid for at least 6 months from arrival",
        "Double-check passport number carefully"
      ]
    },
    {
      "order": 4,
      "title": "Flight Information",
      "description": "Provide your flight and arrival details.",
      "fieldsOnThisScreen": ["arrivalDate", "flightNumber", "portOfArrival", "departureCountry"],
      "tips": [
        "Flight number must match your boarding pass",
        "Bali arrivals use Ngurah Rai (DPS)"
      ]
    },
    {
      "order": 5,
      "title": "Accommodation Details",
      "description": "Enter where you will be staying in Indonesia.",
      "fieldsOnThisScreen": ["accommodationAddress", "cityOfStay", "stayDuration"],
      "tips": [
        "Provide the full address of your first accommodation",
        "Visa on arrival is valid for 30 days and can be extended once"
      ]
    },
    {
      "order": 6,
      "title": "Customs Declaration",
      "description": "Declare any goods, currency, or restricted items you are carrying.",
      "fieldsOnThisScreen": ["carryingCurrency", "currencyAmount", "carryingGoods", "carryingAnimalsPlants", "carryingNarcotics", "carryingCommercialGoods", "alcoholQuantity", "tobaccoQuantity"],
      "tips": [
        "Currency exceeding IDR 100,000,000 (~USD 6,300) must be declared",
        "Duty-free allowance: USD 500 per person, 1L alcohol, 200 cigarettes",
        "SEVERE penalties for undeclared narcotics — Indonesia enforces strict drug laws",
        "Animals and plants require quarantine inspection"
      ]
    },
    {
      "order": 7,
      "title": "Contact Information",
      "description": "Provide your contact details for customs authorities.",
      "fieldsOnThisScreen": ["homeAddress", "phoneNumber", "email"],
      "tips": [
        "Include country code in phone number",
        "Use an email you check regularly"
      ]
    },
    {
      "order": 8,
      "title": "Review and Submit",
      "description": "Review all details and submit your customs declaration.",
      "fieldsOnThisScreen": [],
      "tips": [
        "You will receive a QR code — save it on your phone",
        "Present the QR code to customs officers upon arrival",
        "No fee is required for the e-CD",
        "Keep a screenshot as backup"
      ]
    }
  ],
  "automation": {
    "enabled": false,
    "version": "1.0.0",
    "entryUrl": "https://ecd.beacukai.go.id",
    "testMode": true,
    "successIndicators": [".success-message", "#qr-code-display"],
    "failureIndicators": [".error-message", ".validation-error"],
    "dataExtractionRules": [
      {
        "name": "qrCode",
        "selector": "#qr-code-image",
        "attribute": "src",
        "required": true
      }
    ]
  }
}
