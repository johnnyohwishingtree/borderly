  "submissionGuide": [
    {
      "order": 1,
      "title": "Access India e-Arrival Card Portal",
      "description": "Navigate to the Air Suvidha portal. No account registration is required.",
      "fieldsOnThisScreen": [],
      "tips": [
        "Use the official government portal only",
        "Have your passport, visa, and flight details ready",
        "The form can be completed in a single session"
      ]
    },
    {
      "order": 2,
      "title": "Enter Personal Information",
      "description": "Fill in your personal details exactly as they appear on your passport.",
      "fieldsOnThisScreen": [
        "surname",
        "givenName",
        "middleName",
        "dateOfBirth",
        "placeOfBirth",
        "gender",
        "nationality",
        "occupation"
      ],
      "tips": [
        "Names must match passport exactly",
        "India recognizes 'Other' as a gender option",
        "Select your occupation from the dropdown"
      ]
    },
    {
      "order": 3,
      "title": "Passport and Visa Details",
      "description": "Enter your passport information and Indian visa details.",
      "fieldsOnThisScreen": [
        "passportType",
        "passportNumber",
        "passportIssuedDate",
        "passportExpiry",
        "passportIssuingCountry",
        "visaNumber",
        "visaType"
      ],
      "tips": [
        "Passport must be valid for at least 6 months from arrival date",
        "Enter your e-Visa number if traveling on an e-Visa",
        "Visa-on-arrival is available for some nationalities"
      ]
    },
    {
      "order": 4,
      "title": "Travel Information",
      "description": "Provide details about your travel to India including flight and accommodation.",
      "fieldsOnThisScreen": [
        "purposeOfVisit",
        "arrivalDate",
        "flightNumber",
        "portOfArrival",
        "departureCountry",
        "stayDuration",
        "addressInIndia",
        "cityInIndia",
        "previousIndiaVisit"
      ],
      "tips": [
        "Flight number must match your boarding pass",
        "Select the correct airport of arrival",
        "Provide the complete address of your hotel or host"
      ]
    },
    {
      "order": 5,
      "title": "Health Declaration",
      "description": "Complete the mandatory health screening questions.",
      "fieldsOnThisScreen": [
        "countriesVisitedLast14Days",
        "feverOrCough",
        "contactWithInfected"
      ],
      "tips": [
        "List all countries visited in the last 14 days",
        "Answer health questions truthfully",
        "False declarations may result in penalties"
      ]
    },
    {
      "order": 6,
      "title": "Customs Declaration",
      "description": "Declare any currency, dutiable goods, or restricted items.",
      "fieldsOnThisScreen": [
        "carryingCurrency",
        "currencyAmount",
        "dutiableGoods",
        "prohibitedItems",
        "commercialGoods"
      ],
      "tips": [
        "Currency exceeding USD 5,000 must be declared",
        "Duty-free allowances: 1L alcohol, 100 cigarettes or 25 cigars",
        "Electronics exceeding INR 50,000 may attract duty",
        "Severe penalties for undeclared prohibited items"
      ]
    },
    {
      "order": 7,
      "title": "Contact Information",
      "description": "Provide your contact details and an emergency contact.",
      "fieldsOnThisScreen": [
        "homeAddress",
        "phoneNumber",
        "email",
        "emergencyContactName",
        "emergencyContactPhone"
