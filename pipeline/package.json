{
  "name": "@borderly/pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Inngest-powered CI/CD orchestration for Borderly",
  "scripts": {
    "dev": "npx inngest-cli@latest dev",
    "serve": "tsx src/serve.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --grep 'test.ts$'",
    "test:integration": "vitest run --grep 'integration.test.ts$'",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@octokit/graphql": "^8.2.0",
    "@octokit/rest": "^21.1.0",
    "hono": "^4.7.0",
    "inngest": "^3.27.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.19.0",
    "inngest-cli": "^1.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
