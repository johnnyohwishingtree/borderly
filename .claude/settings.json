{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "frontend-design-audit@frontend-design-audit": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-tool-track.sh"
          }
        ]
      }
    ]
  }
}
